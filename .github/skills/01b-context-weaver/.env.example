# Context Weaver — LLM provider configuration
#
# Only needed if you run scripts/generate-descriptions.js directly (batch generation
# via an API). The primary path — the architect agent writing descriptions itself from
# context-workload.md — needs none of this.
#
# Copy to .env in this folder. Never commit .env; it holds real API keys and is
# gitignored on purpose. Never put a real key in THIS file (.env.example) — it is
# committed to git, unlike .env.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Possible values: anthropic / openai / google
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ------------------------------------------------------
# https://console.anthropic.com/settings/keys
# Secret — no fixed set of values. Starts with sk-ant-...
ANTHROPIC_API_KEY=
# Possible values (current, growing over time — see shared/models.md in the
# claude-api skill for the full catalog): claude-opus-5 / claude-sonnet-5 /
# claude-haiku-4-5 / claude-opus-4-8 / claude-opus-4-7 / claude-fable-5
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI --------------------------------------------------------------------
# https://platform.openai.com/api-keys
# Secret — no fixed set of values. Starts with sk-...
OPENAI_API_KEY=
# Possible values (check platform.openai.com/docs/models for the current list —
# not tracked in this repo the way Anthropic's is): gpt-4o / gpt-4o-mini / gpt-4.1
# / gpt-4.1-mini / o3 / o4-mini
OPENAI_MODEL=gpt-4o

# --- Google (Gemini) -------------------------------------------------------------
# https://aistudio.google.com/apikey
# Secret — no fixed set of values. Starts with AIza...
GOOGLE_API_KEY=
# Possible values (check ai.google.dev/gemini-api/docs/models for the current list
# — not tracked in this repo the way Anthropic's is): gemini-3-flash /
# gemini-3-pro / gemini-2.5-flash / gemini-2.5-pro / gemini-2.0-flash
GOOGLE_MODEL=gemini-3-flash

# ---------------------------------------------------------------------------
# Generation tuning
# ---------------------------------------------------------------------------
# Thinking depth. Anthropic-only — silently ignored by openai/google, since
# "effort" is Claude-specific vocabulary with no equivalent lever there.
# Possible values: low / medium / high / xhigh / max
CONTEXT_EFFORT=high
# Nodes sent to the model per request. Any positive integer.
# Larger = fewer requests but a bigger prompt and more to lose if one batch fails;
# smaller = more requests but each is cheaper to retry. Typical range: 5-20.
CONTEXT_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# Node selection thresholds — same knobs list-context-workload.js exposes as CLI
# flags. A CLI flag passed explicitly always overrides the value here.
# ---------------------------------------------------------------------------
# Any non-negative integer. Higher = fewer Types selected as significant.
# Typical range: 2-6. See 01b-context-weaver/scripts/lib/context.js scoreType() for
# exactly what earns points (Spring stereotype +3, REST endpoints +3, framework
# base +3, fan-in +2, HTTP client +2, injected collaborators +1).
CONTEXT_TYPE_THRESHOLD=3
# Any non-negative integer. Higher = fewer Methods selected as significant.
# Typical range: 2-6. See scoreMethod() in the same file (REST handler +4,
# @Scheduled +4, caller fan-in +3, callee fan-out +2, outbound HTTP +2, long +1).
CONTEXT_METHOD_THRESHOLD=3
# Any non-negative integer. A Package with fewer types than this is skipped
# entirely (no grouping intent to describe). Typical range: 1-3.
CONTEXT_MIN_PACKAGE_TYPES=2
# Any positive integer. Hard cap on the workload size — the highest-scoring nodes
# win when more than this many clear the thresholds above. Raise for a first pass
# over a large codebase; lower to keep a batch-generation run small and cheap.
CONTEXT_MAX_NODES=400
