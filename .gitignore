# Original source clones (with their own .git). legacy-sources/ holds the tracked exports.
merged_repos/

# Maven build output
target/

# Harness run planes (per-run evidence, workspaces, checkpoints). Regenerable; the exported
# evidence package is what gets retained.
runs/
.harness/

# Bootshift run planes when Bootshift is driven directly from legacy-sources/bootshift
legacy-sources/bootshift/output/
legacy-sources/bootshift/bootshift-workspaces/

# IDE / OS
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.DS_Store
Thumbs.db

# Agent 04 skills (.github/skills). Intermediate context bundles, drafted patches, throwaway
# worktrees and migration sandboxes are regenerable. docs/agent_output/ (Pipeline mode's
# deliverables) is meant to be committed and is not ignored.
/.github/.pipeline-context/
.github/skills/**/node_modules/
# 04c's optional local Python venv for the embedding ranking signal (machine-specific, ~900MB)
.github/skills/04c-remediation-intelligence/.venv/
