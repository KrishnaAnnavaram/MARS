<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mars</groupId>
    <artifactId>mars-harness-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>harness-cli</artifactId>
  <name>MARS :: CLI (harness)</name>
  <description>The single developer entry point and composition root: wires kernel engine, adapters and both capability packs.</description>
  <dependencies>
    <dependency><groupId>com.mars</groupId><artifactId>harness-kernel-engine</artifactId></dependency>
    <dependency><groupId>com.mars</groupId><artifactId>capability-spring-migration</artifactId></dependency>
    <dependency><groupId>com.mars</groupId><artifactId>capability-vulnerability-remediation</artifactId></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptorRefs><descriptorRef>jar-with-dependencies</descriptorRef></descriptorRefs>
          <finalName>harness</finalName>
          <appendAssemblyId>false</appendAssemblyId>
          <attach>false</attach>
          <archive><manifest><mainClass>com.mars.harness.cli.HarnessCli</mainClass></manifest></archive>
        </configuration>
        <executions>
          <execution><id>fat-jar</id><phase>package</phase><goals><goal>single</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
