{
  "base_url": "http://localhost:8093",
  "readiness": {
    "path": "/actuator/health",
    "timeout_seconds": 120
  },
  "requests": [
    {
      "name": "endpoint inventory (actuator)",
      "method": "GET",
      "path": "/actuator/mappings",
      "category": "endpoint-inventory"
    },
    {
      "name": "GET /api/v1/employees",
      "method": "GET",
      "path": "/api/v1/employees",
      "category": "endpoint-inventory",
      "handler": "src/main/java/com/example/migrationdemo/controller/EmployeeController.java:31"
    },
    {
      "name": "unauthenticated is 401",
      "method": "GET",
      "path": "/api/v1/employees",
      "no_auth": true,
      "category": "security-boundary",
      "expect_status": 401
    },
    {
      "name": "search by department",
      "method": "GET",
      "path": "/api/v1/employees/search?department=Engineering",
      "category": "business-api",
      "expect_status": 200
    }
  ],
  "auth": {
    "type": "basic",
    "username_env": "APP_USER",
    "password_env": "APP_PASSWORD"
  }
}