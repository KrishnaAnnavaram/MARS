<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.bootshift</groupId>
    <artifactId>bootshift-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>bootshift-cli</artifactId>
  <name>Bootshift :: Migration CLI</name>
  <description>Picocli entry point. No migration semantics live here.</description>
  <dependencies>
    <dependency><groupId>com.bootshift</groupId><artifactId>bootshift-stages</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></dependency>
  </dependencies>
  <build>
    <finalName>bootshift</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <archive><manifest><mainClass>com.bootshift.cli.BootshiftCli</mainClass></manifest></archive>
          <descriptorRefs><descriptorRef>jar-with-dependencies</descriptorRef></descriptorRefs>
          <appendAssemblyId>false</appendAssemblyId>
          <!--
            The executable jar is produced at the documented path but is NOT attached as this
            module's Maven artifact. Attaching it replaced the thin jar, so every consumer -
            including the tests module - resolved a shaded copy containing a duplicate of every
            class in the reactor. Tests then ran against whichever copy the classloader reached
            first, which is the copy from the last full `package`, not the one just compiled. A
            source fix could be verified as failing purely because the fat jar was stale.
          -->
          <attach>false</attach>
        </configuration>
        <executions>
          <execution><id>make-cli</id><phase>package</phase><goals><goal>single</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
