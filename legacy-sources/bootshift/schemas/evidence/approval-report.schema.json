{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval report",
  "description": "Human decisions the harness must not make for itself (spec section 36). An empty rationale is not a decision.",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "decision_count",
    "outstanding_requests",
    "decisions"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "decision_count": {
      "type": "integer",
      "minimum": 0
    },
    "outstanding_requests": {
      "type": "integer",
      "minimum": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decisionId",
          "gate",
          "actor",
          "verdict",
          "rationale",
          "signature"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "pattern": "^DEC-[0-9]{5}$"
          },
          "request_id": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "APPROVED",
              "REJECTED",
              "DEFERRED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
