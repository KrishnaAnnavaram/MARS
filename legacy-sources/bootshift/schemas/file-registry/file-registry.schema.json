{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File registry",
  "description": "Persistent file identity (spec section 11). FILE_ID is allocated, never derived from path or content.",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "count",
    "files"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "similarity_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seal_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fileId",
          "baselinePath",
          "currentPath",
          "role",
          "status"
        ],
        "properties": {
          "fileId": {
            "type": "string",
            "pattern": "^FILE-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "module": {
            "type": [
              "string",
              "null"
            ]
          },
          "baselinePath": {
            "type": "string"
          },
          "currentPath": {
            "type": "string"
          },
          "baselineSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "currentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DELETED",
              "MERGED_AWAY"
            ]
          },
          "renameSource": {
            "enum": [
              "PROVIDER",
              "GIT",
              "SIMILARITY",
              "NONE"
            ]
          },
          "renameConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "splitFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "mergedInto": {
            "type": [
              "string",
              "null"
            ]
          },
          "versions": {
            "type": "array"
          },
          "changeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
