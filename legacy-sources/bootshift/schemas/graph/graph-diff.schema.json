{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph diff",
  "description": "Static/semantic difference between the last known-good graph and the current graph (Agent 14).",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "partial",
    "counts",
    "changed_file_ids",
    "changed_symbol_ids"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "before_label": {
      "type": "string"
    },
    "after_label": {
      "type": "string"
    },
    "before_structural_hash": {
      "type": "string"
    },
    "after_structural_hash": {
      "type": "string"
    },
    "partial": {
      "type": "boolean"
    },
    "counts": {
      "type": "object"
    },
    "nodes_added": {
      "type": "array"
    },
    "nodes_removed": {
      "type": "array"
    },
    "nodes_changed": {
      "type": "array"
    },
    "edges_added": {
      "type": "array"
    },
    "edges_removed": {
      "type": "array"
    },
    "changed_file_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_symbol_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
