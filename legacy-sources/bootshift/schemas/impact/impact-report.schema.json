{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Impact report",
  "description": "Which parts of this repository the verified facts affect (spec section 20).",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "finding_count",
    "findings"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "affected_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "accuracy": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "impact_id",
          "classification"
        ],
        "properties": {
          "impact_id": {
            "type": "string",
            "pattern": "^IMPACT-[0-9]{5}$"
          },
          "knowledge_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "enum": [
              "DEFINITELY_AFFECTED",
              "LIKELY_AFFECTED",
              "POSSIBLY_AFFECTED",
              "UNAFFECTED_WITHIN_OBSERVED_COVERAGE"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "attribution_capped": {
            "type": "boolean"
          },
          "graph_path": {
            "type": "array"
          },
          "required_validation_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blind_spots": {
            "type": "array"
          }
        }
      }
    }
  }
}
