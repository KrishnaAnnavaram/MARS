{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory artifact",
  "description": "Agent 01 output. Describes what repository was received and how it was classified.",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "root",
    "file_count",
    "modules"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "root": {
      "type": "string"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "role_counts": {
      "type": "object"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "file_count",
          "build_system"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "java_main": {
            "type": "integer",
            "minimum": 0
          },
          "java_test": {
            "type": "integer",
            "minimum": 0
          },
          "build_system": {
            "enum": [
              "MAVEN",
              "GRADLE",
              "UNKNOWN"
            ]
          },
          "role_counts": {
            "type": "object"
          }
        }
      }
    },
    "excluded_directories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file_id",
          "path",
          "rule"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^FILE-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "path": {
            "type": "string"
          },
          "previous_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "rename_source": {
            "enum": [
              "PROVIDER",
              "GIT",
              "SIMILARITY",
              "NONE"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "newly_allocated": {
            "type": "boolean"
          },
          "rule": {
            "enum": [
              "EXACT_PATH",
              "PROVIDER_RENAME",
              "EXACT_CONTENT_HASH",
              "SIMILARITY",
              "ALLOCATE_NEW"
            ]
          }
        }
      }
    }
  }
}
