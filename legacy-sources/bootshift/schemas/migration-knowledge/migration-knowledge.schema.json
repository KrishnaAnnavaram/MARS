{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration knowledge",
  "description": "Verified migration facts (spec section 19). Only VERIFIED facts may authorize a transformation.",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "source_version",
    "target_version",
    "fact_count",
    "facts"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "source_version": {
      "type": "string"
    },
    "target_version": {
      "type": "string"
    },
    "fact_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_count": {
      "type": "integer",
      "minimum": 0
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "knowledge_id",
          "type",
          "subject",
          "status",
          "channel",
          "authorizes_transformation"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^MK-[0-9]{5}$"
          },
          "type": {
            "enum": [
              "API_REMOVED",
              "API_RENAMED",
              "API_SIGNATURE_CHANGED",
              "PROPERTY_REMOVED",
              "PROPERTY_RENAMED",
              "PROPERTY_SILENTLY_IGNORED",
              "DEFAULT_CHANGED",
              "ARTIFACT_REMOVED",
              "ARTIFACT_RELOCATED",
              "MANAGED_VERSION_CHANGED",
              "BEHAVIOR_CHANGED_NO_API_CHANGE",
              "COMPATIBILITY_REQUIREMENT",
              "BASELINE_REQUIREMENT"
            ]
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CANDIDATE",
              "VERIFIED",
              "CONFLICTING",
              "REJECTED"
            ]
          },
          "channel": {
            "enum": [
              "DOCUMENTATION",
              "ARTIFACT",
              "BOTH"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "authorizes_transformation": {
            "type": "boolean"
          },
          "document_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
