{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Symbol registry",
  "description": "Every application-owned symbol with its attribution status (spec section 13).",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "symbol_count",
    "symbols"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "symbol_count": {
      "type": "integer",
      "minimum": 0
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbolId",
          "fqn",
          "kind",
          "attribution"
        ],
        "properties": {
          "symbolId": {
            "type": "string",
            "pattern": "^SYM-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "fileId": {
            "type": [
              "string",
              "null"
            ]
          },
          "module": {
            "type": [
              "string",
              "null"
            ]
          },
          "packageName": {
            "type": [
              "string",
              "null"
            ]
          },
          "fqn": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "lineStart": {
            "type": "integer"
          },
          "lineEnd": {
            "type": "integer"
          },
          "attribution": {
            "enum": [
              "RESOLVED",
              "UNRESOLVED",
              "AMBIGUOUS"
            ]
          }
        }
      }
    }
  }
}
