# Optional. Only needed if this skill folder is used standalone.
# By default the impact collector reads ../01c-graph-forge/.env, so if Graph Forge is
# already configured there is nothing to do here.
# Copy to .env in this folder and fill in your Neo4j instance details to override.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD="<password>"
NEO4J_DATABASE=neo4j
