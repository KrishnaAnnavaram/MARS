<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mars</groupId>
  <artifactId>mars-harness-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>MARS Unified Harness</name>
  <description>
    Unified Modernization, Assessment, Remediation and Security harness: one kernel (identity, graph,
    evidence, ledger, decisions, mutation gateway, validation) with two capability packs (Spring
    migration, vulnerability remediation).

    legacy-sources/bootshift is built unchanged as part of this reactor. Its core, ports, adapters and
    stages are the shared-kernel base the unified kernel extends; its own tests run with every build so
    a regression in preserved behaviour fails this build.
  </description>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>legacy-sources/bootshift</module>
    <module>kernel/core</module>
    <module>kernel/ports</module>
    <module>kernel/adapters</module>
    <module>kernel/engine</module>
    <module>capabilities/spring-migration</module>
    <module>capabilities/vulnerability-remediation</module>
    <module>apps/cli</module>
    <module>tests</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <bootshift.version>1.0.0</bootshift.version>
    <jackson.version>2.17.2</jackson.version>
    <picocli.version>4.7.6</picocli.version>
    <javaparser.version>3.26.2</javaparser.version>
    <slf4j.version>2.0.13</slf4j.version>
    <junit.version>5.10.3</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <archunit.version>1.3.0</archunit.version>
    <jsonschema.version>1.5.1</jsonschema.version>
    <surefire.version>3.2.5</surefire.version>
    <compiler.plugin.version>3.13.0</compiler.plugin.version>
    <assembly.plugin.version>3.7.1</assembly.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.bootshift</groupId><artifactId>bootshift-core</artifactId><version>${bootshift.version}</version></dependency>
      <dependency><groupId>com.bootshift</groupId><artifactId>bootshift-ports</artifactId><version>${bootshift.version}</version></dependency>
      <dependency><groupId>com.bootshift</groupId><artifactId>bootshift-adapters</artifactId><version>${bootshift.version}</version></dependency>
      <dependency><groupId>com.bootshift</groupId><artifactId>bootshift-stages</artifactId><version>${bootshift.version}</version></dependency>

      <dependency><groupId>com.mars</groupId><artifactId>harness-kernel-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.mars</groupId><artifactId>harness-kernel-ports</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.mars</groupId><artifactId>harness-kernel-adapters</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.mars</groupId><artifactId>harness-kernel-engine</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.mars</groupId><artifactId>capability-spring-migration</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.mars</groupId><artifactId>capability-vulnerability-remediation</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.mars</groupId><artifactId>harness-cli</artifactId><version>${project.version}</version></dependency>

      <!-- Mirrors Bootshift's parent dependencyManagement exactly, so every module resolves the same
           versions Bootshift was built and tested against (no silent transitive upgrades). -->
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-xml</artifactId><version>${jackson.version}</version></dependency>
      <dependency><groupId>org.eclipse.jgit</groupId><artifactId>org.eclipse.jgit</artifactId><version>6.10.0.202406032230-r</version></dependency>
      <dependency><groupId>com.github.javaparser</groupId><artifactId>javaparser-symbol-solver-core</artifactId><version>${javaparser.version}</version></dependency>
      <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId><version>2.2</version></dependency>
      <dependency>
        <groupId>org.openrewrite</groupId>
        <artifactId>rewrite-bom</artifactId>
        <version>8.90.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId><version>${picocli.version}</version></dependency>
      <dependency><groupId>com.github.javaparser</groupId><artifactId>javaparser-core</artifactId><version>${javaparser.version}</version></dependency>
      <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>${jsonschema.version}</version></dependency>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${slf4j.version}</version></dependency>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>${slf4j.version}</version></dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>${assertj.version}</version><scope>test</scope></dependency>
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version><scope>test</scope></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Pinned for the same reason Bootshift pins them: Maven 3.8 defaults the compiler plugin to 3.1,
             which predates the release option. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${assembly.plugin.version}</version>
        </plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.1.2</version></plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
