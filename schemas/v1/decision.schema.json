{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.harness/schemas/v1/decision.schema.json",
  "title": "Human decision (spec §9, §17, §23)",
  "$comment": "Write-once, HMAC integrity-hashed. The actor is locally asserted (no identity provider is claimed). Reserved machine identities are refused by DecisionValidator, which this schema complements; an LLM proposal's provenance is enforced by the Mutation Gateway, not here.",
  "type": "object",
  "required": ["decision_id", "run_id", "type", "selected", "finding_ids", "affected_file_ids", "affected_symbol_ids",
               "affected_statement_ids", "baseline_seal", "actor", "role", "actor_authentication", "rationale",
               "timestamp", "policy_version", "integrity_hash"],
  "properties": {
    "decision_id": { "$ref": "common.schema.json#/$defs/decision_id" },
    "run_id": { "$ref": "common.schema.json#/$defs/run_id" },
    "type": { "enum": ["EXECUTION_STRATEGY", "POST_SECURITY_MIGRATION", "PROPOSAL_APPROVAL", "MIGRATION_PLAN_APPROVAL",
                       "APPLY_TO_PROJECT"] },
    "selected": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string" },
    "proposal_id": { "$ref": "common.schema.json#/$defs/proposal_id" },
    "proposal_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "finding_ids": { "$ref": "common.schema.json#/$defs/strings" },
    "affected_file_ids": { "$ref": "common.schema.json#/$defs/strings" },
    "affected_symbol_ids": { "$ref": "common.schema.json#/$defs/strings" },
    "affected_statement_ids": { "$ref": "common.schema.json#/$defs/strings" },
    "plan_id": { "type": "string" },
    "plan_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "assessment_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "baseline_seal": { "$ref": "common.schema.json#/$defs/sha256" },
    "ledger_head": { "type": "string" },
    "actor": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "actor_authentication": { "const": "LOCALLY_ASSERTED" },
    "rationale": { "type": "string", "pattern": "\\S" },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
    "policy_version": { "type": "string" },
    "integrity_hash": { "type": "string", "minLength": 32 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "EXECUTION_STRATEGY" } } },
      "then": { "required": ["assessment_hash"], "properties": { "selected": { "enum": ["MIGRATE_FIRST", "SECURITY_FIRST",
        "MIGRATION_ONLY", "SECURITY_ONLY", "ANALYZE_ONLY", "STOP"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "POST_SECURITY_MIGRATION" } } },
      "then": { "required": ["assessment_hash"], "properties": { "selected": { "enum": ["PROCEED", "SKIP", "STOP"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "PROPOSAL_APPROVAL" } } },
      "then": { "required": ["proposal_id", "proposal_hash"],
                "properties": { "selected": { "enum": ["APPROVED", "REJECTED", "DEFERRED"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "MIGRATION_PLAN_APPROVAL" } } },
      "then": { "required": ["plan_id", "plan_hash"], "properties": { "selected": { "enum": ["APPROVED", "REJECTED", "DEFERRED"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "APPLY_TO_PROJECT" } } },
      "then": { "required": ["ledger_head"], "properties": { "selected": { "enum": ["APPROVED", "REJECTED", "DEFERRED"] } } }
    }
  ],
  "additionalProperties": false
}
