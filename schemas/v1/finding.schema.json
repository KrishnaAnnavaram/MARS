{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.harness/schemas/v1/finding.schema.json",
  "title": "Canonical finding (spec §14)",
  "$comment": "Every source (VRH issue register, SARIF, harness scanner, dependency advisories) normalizes into this one shape, anchored to identity rather than to a path and line.",
  "type": "object",
  "required": ["finding_id", "source", "source_finding_id", "cwe", "cve", "severity", "status", "title", "code_flow",
               "fingerprint", "evidence_refs", "first_seen_run", "last_seen_run", "affected_symbols", "affected_files",
               "anchor_quality"],
  "properties": {
    "finding_id": { "$ref": "common.schema.json#/$defs/finding_id" },
    "source": { "type": "string", "minLength": 1 },
    "source_finding_id": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string" },
    "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-\\d+$" } },
    "cve": { "type": "array", "items": { "type": "string", "pattern": "^CVE-\\d{4}-\\d+$" } },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"] },
    "status": { "enum": ["OPEN", "IN_PROGRESS", "FIXED", "CLOSED", "UNKNOWN"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "file_id": { "$ref": "common.schema.json#/$defs/file_id" },
    "program_unit_id": { "$ref": "common.schema.json#/$defs/program_unit_id" },
    "symbol_id": { "$ref": "common.schema.json#/$defs/symbol_id" },
    "statement_id": { "$ref": "common.schema.json#/$defs/statement_id" },
    "location": { "$ref": "common.schema.json#/$defs/location" },
    "code_flow": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/location" } },
    "fingerprint": { "type": "string", "minLength": 1 },
    "root_cause_ref": { "type": "string" },
    "blast_radius_ref": { "type": "string" },
    "evidence_refs": { "allOf": [{ "$ref": "common.schema.json#/$defs/evidence_refs" }, { "minItems": 1 }] },
    "first_seen_run": { "$ref": "common.schema.json#/$defs/run_id" },
    "last_seen_run": { "$ref": "common.schema.json#/$defs/run_id" },
    "resolution": { "type": "object" },
    "platform_requirement": {
      "type": "object",
      "required": ["component", "minimum_fixed_version", "requires_platform", "requires_platform_minimum", "basis",
                   "evidence_refs"],
      "properties": {
        "component": { "type": "string" },
        "current_version": { "type": "string" },
        "minimum_fixed_version": { "type": "string" },
        "requires_platform": { "type": "string" },
        "requires_platform_minimum": { "type": "string" },
        "requires_java_minimum": { "type": "string" },
        "basis": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "common.schema.json#/$defs/evidence_refs" }
      },
      "additionalProperties": false
    },
    "affected_symbols": { "$ref": "common.schema.json#/$defs/strings" },
    "affected_files": { "$ref": "common.schema.json#/$defs/strings" },
    "anchor_quality": { "enum": ["STATEMENT", "SYMBOL", "PROGRAM_UNIT", "FILE", "UNANCHORED"] }
  },
  "additionalProperties": false
}
