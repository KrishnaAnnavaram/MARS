{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.harness/schemas/v1/lineage-entry.schema.json",
  "title": "Lineage ledger entry (spec §19)",
  "$comment": "The kernel's sub-file lineage, alongside Bootshift's ChangeLedger (whose schema is unchanged). Each line of ledger/lineage-ledger.jsonl wraps one entry as {previous_hash, hash, entry} (the same chain rule as the ChangeLedger).",
  "type": "object",
  "required": ["sequence", "kind", "finding_refs", "migration_refs", "evidence_refs", "symbol_ids", "statement_ids_changed",
               "statement_ids_created", "statement_ids_deleted", "validation_refs", "status", "at"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["CHANGE", "REJECTION", "VALIDATION", "APPLY_TO_PROJECT"] },
    "change_id": { "$ref": "common.schema.json#/$defs/change_id" },
    "proposal_id": { "$ref": "common.schema.json#/$defs/proposal_id" },
    "decision_id": { "type": "string" },
    "capability": { "enum": ["MIGRATION", "SECURITY", "MANUAL"] },
    "provider": { "type": "string" },
    "actor": { "type": "string" },
    "reason": { "type": "string" },
    "finding_refs": { "$ref": "common.schema.json#/$defs/strings" },
    "migration_refs": { "$ref": "common.schema.json#/$defs/strings" },
    "evidence_refs": { "$ref": "common.schema.json#/$defs/strings" },
    "file_id": { "$ref": "common.schema.json#/$defs/file_id" },
    "path_before": { "type": "string" },
    "path_after": { "type": "string" },
    "hash_before": { "type": "string" },
    "hash_after": { "type": "string" },
    "symbol_ids": { "$ref": "common.schema.json#/$defs/strings" },
    "statement_ids_changed": { "$ref": "common.schema.json#/$defs/strings" },
    "statement_ids_created": { "$ref": "common.schema.json#/$defs/strings" },
    "statement_ids_deleted": { "$ref": "common.schema.json#/$defs/strings" },
    "validation_refs": { "$ref": "common.schema.json#/$defs/strings" },
    "status": { "type": "string" },
    "at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "CHANGE" } } },
      "then": { "required": ["change_id", "proposal_id", "capability", "file_id"] } }
  ],
  "additionalProperties": false
}
