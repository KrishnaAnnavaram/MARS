{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.harness/schemas/v1/validation-result.schema.json",
  "title": "Unified validation result (spec §21)",
  "$comment": "NOT_RUN, NOT_COMPARED, TOOL_UNAVAILABLE and INSUFFICIENT_EVIDENCE are distinct from PASS and are never counted as one. A mandatory dimension that is absent counts as NOT_RUN.",
  "type": "object",
  "required": ["validation_id", "run_id", "scope", "generated_at", "dimensions", "mandatory"],
  "properties": {
    "validation_id": { "type": "string", "pattern": "^VAL-[0-9A-HJKMNP-TV-Z]{26}$" },
    "run_id": { "$ref": "common.schema.json#/$defs/run_id" },
    "scope": { "type": "string" },
    "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "status", "summary", "evidence_refs", "producer"],
        "properties": {
          "dimension": { "$ref": "#/$defs/dimension" },
          "status": { "enum": ["PASS", "FAIL", "PASS_WITH_EXPLAINED_DIFFERENCES", "NOT_RUN", "NOT_APPLICABLE", "NOT_COMPARED",
                               "TOOL_UNAVAILABLE", "INSUFFICIENT_EVIDENCE"] },
          "detail": { "type": "string" },
          "summary": { "type": "string" },
          "evidence_refs": { "$ref": "common.schema.json#/$defs/strings" },
          "producer": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "mandatory": { "type": "array", "items": { "$ref": "#/$defs/dimension" } }
  },
  "$defs": {
    "dimension": { "enum": ["COMPILE", "TESTS", "BUILD_PACKAGE", "SECURITY_RESCAN", "DEPENDENCY_SCAN", "RUNTIME_STARTUP",
                            "BEHAVIOR_PROBES", "OLD_NEW_DIFFERENTIAL", "GRAPH_DIFF", "RED_TEAM", "EVIDENCE_COVERAGE",
                            "IDENTITY_INTEGRITY", "MUTATION_BYPASS"] }
  },
  "additionalProperties": false
}
