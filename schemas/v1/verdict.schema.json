{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars.harness/schemas/v1/verdict.schema.json",
  "title": "Final verdict (spec §22)",
  "$comment": "Precedence BLOCKED > NEEDS_HUMAN > INSUFFICIENT_EVIDENCE > PARTIAL > CLEARED. A CLEARED verdict carries no hard failure, no pending decision and no unknown mandatory dimension.",
  "type": "object",
  "required": ["run_id", "outcome", "generated_at", "items", "reasons", "hard_failures", "unknown_dimensions",
               "pending_decisions", "evidence_refs", "policy_version"],
  "properties": {
    "run_id": { "$ref": "common.schema.json#/$defs/run_id" },
    "outcome": { "enum": ["CLEARED", "BLOCKED", "PARTIAL", "NEEDS_HUMAN", "INSUFFICIENT_EVIDENCE"] },
    "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "kind", "status", "reason", "evidence_refs"],
        "properties": {
          "item_id": { "type": "string" },
          "kind": { "enum": ["finding", "capability"] },
          "status": { "enum": ["FIXED", "STILL_VULNERABLE", "BLOCKED_BY_PLATFORM", "DEFERRED_BY_DEVELOPER",
                               "REJECTED_BY_DEVELOPER", "NOT_APPLICABLE", "NOT_COMPARED", "PENDING_APPROVAL", "NEEDS_HUMAN",
                               "INSUFFICIENT_EVIDENCE", "FAILED", "MIGRATED", "MIGRATION_DECLINED", "MIGRATION_INCOMPLETE",
                               "NOT_IN_SCOPE"] },
          "legacy_verdict": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "evidence_refs": { "$ref": "common.schema.json#/$defs/strings" }
        },
        "additionalProperties": false
      }
    },
    "reasons": { "$ref": "common.schema.json#/$defs/strings" },
    "hard_failures": { "$ref": "common.schema.json#/$defs/strings" },
    "unknown_dimensions": { "$ref": "common.schema.json#/$defs/strings" },
    "pending_decisions": { "$ref": "common.schema.json#/$defs/strings" },
    "evidence_refs": { "$ref": "common.schema.json#/$defs/strings" },
    "policy_version": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "outcome": { "const": "CLEARED" } } },
      "then": { "properties": { "hard_failures": { "maxItems": 0 }, "pending_decisions": { "maxItems": 0 },
                                "unknown_dimensions": { "maxItems": 0 } } } },
    { "if": { "properties": { "hard_failures": { "minItems": 1 } } },
      "then": { "properties": { "outcome": { "const": "BLOCKED" } } } }
  ],
  "additionalProperties": false
}
